let backgroundImagePath = 'data/tomato_chiikawa.jpg';
let backgroundMusicPath = 'data/kurimanju_bgm.mp3';
let starSoundPath = '';
let crashSoundPath = '';
let stageSoundPath = '';

let backgroundImage;
let backgroundMusic;
let starSound;
let crashSound;
let stageSound;

let musicStarted = 0;
let musicPreviousTime = 0;
let musicRepeatTime = 30070;

// 게임 상태
let canvasWidth = 600;
let canvasHeight = 600;
let step = 0;
let stage = 1;
let score = 0;
let gameTime = 30;
let gameResult = 0;

// 시간 계산
let currentTime = 0;
let previousTime = 0;
let interval = 0;
let setTime = 1000;

// 큰 비행기
let planeX = 0;
let planeY = 0;
let state = 0;
let planeDistance = 0;

let bodyWidth = 10;
let bodyHeight = 49;
let wingWidth = 49;
let wingHeight = 10;
let tailWidth = 25;
let tailHeight = 7;
let planeWingY = 4;
let planeTailY = 19;
let planeNoseY = 25;
let planeNoseHeight = 13;
let noseY = 0;

// 작은 비행기
let skyPlaneX = [-60, -170, -280, -390, -500, -610, -720];
let skyPlaneY = [100, 140, 90, 180, 120, 200, 150];
let skyPlaneSpeedX = [0, 0, 0, 0, 0, 0, 0];
let skyPlaneSpeedY = [0, 0, 0, 0, 0, 0, 0];

let skyPlaneCount = 3;
let skyPlaneMaxCount = 7;
let planeCountRandom = 0;
let skyPlaneRightEnd = 630;
let skyPlaneLeftStart = -30;
let skyPlaneMinY = 60;
let skyPlaneMaxY = 280;

// 작은 비행기 모양
let skyBodyWidth = 24;
let skyBodyHeight = 3;
let skyNoseX = 12;
let skyNoseWidth = 5;
let skyNoseHeight = 4;
let skyWingY = 3;
let skyWingWidth = 10;
let skyWingHeight = 3;
let skyTailX = 9;
let skyTailY = 3;
let skyTailWidth = 4;
let skyTailHeight = 6;

// 작은 비행기 색
let skyColor = 0;
let skyWhite;
let skyRed;
let skyGreen;
let skyBlue;

// 별
let starsX = [100, 200, 300, 400, 500];
let starsY = [100, 150, 80, 200, 130];
let starCount = 5;
let starSize = 5;
let starDistance = 0;
let starVisible = [1, 1, 1, 1, 1];

// 별 효과
let starColorDistance = 60;
let starLightDistance = 15;
let starLightCount = 6;
let starLightMin = -15;
let starLightMax = 15;
let offsetX = 0;
let offsetY = 0;
let endX = 0;
let endY = 0;

// 도로
let solidLineY = 330;
let dashedLineY = 480;
let dashedLineSpace = 40;
let dashedLineLength = 20;

// 자동차
let carX = 300;
let carSpeed = 4;
let carBodyY = 311;
let carBodyWidth = 60;
let carBodyHeight = 18;
let carRoofY = 300;
let carRoofWidth = 36;
let carRoofHeight = 15;
let carWheelX = 18;
let carWheelY = 323;
let carWheelSize = 11;
let carWindowX = 9;
let carWindowY = 300;

// 자동차 충돌
let carCollisionWidth = 30;
let carCollisionTop = 290;
let carCollisionBottom = 330;
let planeCollisionSize = 25;
let hit = 0;
let previousHit = 0;
let shake = 0;
let shakeMin = -5;
let shakeMax = 5;

// 착륙등
let landingLight = 0;
let lightSize = 12;
let lightMaxSize = 50;

let i = 0;
let j = 0;

// 이미지와 음악 불러오기
async function setup() {
  if (backgroundImagePath !== '') {
    backgroundImage = await loadImage(backgroundImagePath);
  }

  if (backgroundMusicPath !== '') {
    backgroundMusic = await loadSound(backgroundMusicPath);
  }

  if (starSoundPath !== '') {
    starSound = await loadSound(starSoundPath);
  }

  if (crashSoundPath !== '') {
    crashSound = await loadSound(crashSoundPath);
  }

  if (stageSoundPath !== '') {
    stageSound = await loadSound(stageSoundPath);
  }

  createCanvas(canvasWidth, canvasHeight);
  imageMode(CENTER);
  rectMode(CENTER);

  skyWhite = color(255);
  skyRed = color(255, 0, 0);
  skyGreen = color(0, 255, 0);
  skyBlue = color(0, 100, 255);

  reset();
}

// 화면 상태
function draw() {
  if (step === 0) {
    gameStart();
  }
  else if (step === 1) {
    gameOn();
  }
  else if (step === 2) {
    gameEnd();
  }
}

// 배경 사진
function drawBackground() {
  background(0);

  if (backgroundImagePath !== '') {
    image(backgroundImage, width / 2, height / 2, width, height);
  }
}

// 시작 화면
function gameStart() {
  drawBackground();

  fill(0);
  noStroke();
  rect(width / 2, 290, 560, 225);

  fill(255);
  textAlign(CENTER, CENTER);

  textSize(38);
  text('AIRPLANE MISSION', width / 2, 210);

  textSize(22);
  text('PRESS SPACE TO START', width / 2, 265);

  textSize(16);
  text('MOUSE: PLANE  /  CLICK: LIGHT', width / 2, 312);
  text('LEFT / RIGHT: CAR  /  1 2 3: COLOR', width / 2, 340);

  noLoop();
}

// 게임 실행
function gameOn() {
  repeatBackgroundMusic();
  drawBackground();

  // 큰 비행기는 마우스를 따라 이동
  planeX = constrain(mouseX, 25, width - 25);
  planeY = constrain(mouseY, 30, height - 30);

  drawStars();

  changeSkyPlaneColor();
  moveSkyPlanes();
  drawSkyPlanes();
  checkSkyPlaneCollision();

  drawRoad();
  moveCar();
  drawCar();
  checkCarCollision();
  checkPlaneState();

  // 마우스를 누르고 있으면 착륙등 빛 확장
  if (landingLight == 1 && mouseIsPressed && lightSize < lightMaxSize) {
    lightSize += 0.2;
  }

  drawMousePlane();
  timerProcess();
  displayGameInfo();
  checkStage();
}

// 30초 배경음악 반복
function repeatBackgroundMusic() {
  if (backgroundMusicPath !== '' && musicStarted == 1) {
    if (millis() - musicPreviousTime > musicRepeatTime) {
      backgroundMusic.play();
      musicPreviousTime = millis();
    }
  }
}

// 스테이지, 점수, 시간 표시
function displayGameInfo() {
  fill(0);
  noStroke();
  rect(width / 2, 18, width, 36);

  fill(255);
  textAlign(CENTER, CENTER);
  textSize(17);

  text('STAGE: ' + stage, 69, 19);
  text('SCORE: ' + score, 206, 19);
  text('PLANES: ' + skyPlaneCount, 365, 19);
  text('TIME: ' + gameTime, 520, 19);
}

// 1초마다 시간 감소
function timerProcess() {
  currentTime = millis();
  interval = currentTime - previousTime;

  if (step === 1 && interval > setTime) {
    previousTime = millis();
    gameTime--;
  }

  // 시간 초과
  if (step === 1 && gameTime <= 0) {
    gameTime = 0;
    gameResult = 0;
    step = 2;

    if (crashSoundPath !== '') {
      crashSound.play();
    }
  }
}

// 별 그리기
function drawStars() {
  for (i = 0; i < starCount; i++) {
    if (starVisible[i] == 1) {
      starDistance = dist(planeX, planeY, starsX[i], starsY[i]);

      starColor();
      noStroke();

      ellipse(starsX[i], starsY[i], starSize, starSize);

      // 별을 먹으면 점수 증가
      if (starDistance < 8) {
        starVisible[i] = 0;
        score++;

        if (starSoundPath !== '') {
          starSound.play();
        }
      }

      // 별 근처에서 빛나는 효과
      else if (starDistance < starLightDistance) {
        stroke(255, 255, 0);
        strokeWeight(1);

        for (j = 0; j < starLightCount; j++) {
          offsetX = random(starLightMin, starLightMax);
          offsetY = random(starLightMin, starLightMax);

          endX = planeX + offsetX;
          endY = planeY + offsetY;

          line(planeX, planeY, endX, endY);
        }
      }
    }
  }
}

// 별 색 변화
function starColor() {
  if (starDistance < starColorDistance) {
    fill(255, 255, starDistance * 255 / starColorDistance);
  }
  else {
    fill(255);
  }
}

// 1, 2, 3키로 작은 비행기 색 변경
function changeSkyPlaneColor() {
  if (keyIsPressed && key === '1') {
    skyColor = 1;
  }
  else if (keyIsPressed && key === '2') {
    skyColor = 2;
  }
  else if (keyIsPressed && key === '3') {
    skyColor = 3;
  }
  else {
    skyColor = 0;
  }
}

// 작은 비행기 이동
function moveSkyPlanes() {
  for (i = 0; i < skyPlaneCount; i++) {
    skyPlaneX[i] += skyPlaneSpeedX[i];
    skyPlaneY[i] -= skyPlaneSpeedY[i];

    // 오른쪽으로 나가면 왼쪽에서 재등장
    if (skyPlaneX[i] > skyPlaneRightEnd) {
      skyPlaneX[i] = skyPlaneLeftStart;
      skyPlaneY[i] = random(skyPlaneMinY, skyPlaneMaxY);
    }
  }
}

// 작은 비행기 여러 대 그리기
function drawSkyPlanes() {
  noStroke();
  rectMode(CENTER);

  if (skyColor == 0) {
    fill(skyWhite);
  }
  else if (skyColor == 1) {
    fill(skyRed);
  }
  else if (skyColor == 2) {
    fill(skyGreen);
  }
  else {
    fill(skyBlue);
  }

  for (i = 0; i < skyPlaneCount; i++) {
    drawSkyPlane(skyPlaneX[i], skyPlaneY[i]);
  }
}

// 작은 비행기 한 대 그리기
function drawSkyPlane(x, y) {
  rect(x, y, skyBodyWidth, skyBodyHeight);
  ellipse(x + skyNoseX, y, skyNoseWidth, skyNoseHeight);
  rect(x, y + skyWingY, skyWingWidth, skyWingHeight);
  rect(x - skyTailX, y - skyTailY, skyTailWidth, skyTailHeight);
}

// 작은 비행기 충돌 확인
function checkSkyPlaneCollision() {
  if (step === 1) {
    for (i = 0; i < skyPlaneCount; i++) {
      planeDistance = dist(planeX, planeY, skyPlaneX[i], skyPlaneY[i]);

      // 충돌하면 GAME OVER
      if (planeDistance < 30 && step === 1) {
        gameResult = 0;
        step = 2;

        if (crashSoundPath !== '') {
          crashSound.play();
        }
      }
    }
  }
}

// 노란 실선과 점선
function drawRoad() {
  stroke(255, 255, 0);
  strokeWeight(4);
  line(0, solidLineY, canvasWidth, solidLineY);

  strokeWeight(3);

  for (i = 0; i < canvasWidth; i += dashedLineSpace) {
    line(i, dashedLineY, i + dashedLineLength, dashedLineY);
  }
}

// 방향키로 자동차 이동
function moveCar() {
  if (keyIsPressed) {
    if (keyCode === 37) {
      carX -= carSpeed;
    }
    else if (keyCode === 39) {
      carX += carSpeed;
    }
  }

  carX = constrain(carX, 30, width - 30);
}

// 자동차 그리기
function drawCar() {
  noStroke();
  rectMode(CENTER);
  fill(255);

  // 몸체와 지붕
  rect(carX, carBodyY, carBodyWidth, carBodyHeight);
  rect(carX, carRoofY, carRoofWidth, carRoofHeight);

  // 바퀴
  ellipse(carX - carWheelX, carWheelY, carWheelSize, carWheelSize);
  ellipse(carX + carWheelX, carWheelY, carWheelSize, carWheelSize);

  // 창문
  fill(0);
  rect(carX - carWindowX, carWindowY, 9, 8);
  rect(carX + carWindowX, carWindowY, 9, 8);
}

// 자동차 충돌 시 비행기 진동
function checkCarCollision() {
  if (
    planeX + planeCollisionSize > carX - carCollisionWidth &&
    planeX - planeCollisionSize < carX + carCollisionWidth &&
    planeY + planeCollisionSize > carCollisionTop &&
    planeY - planeCollisionSize < carCollisionBottom
  ) {
    hit = 1;
  }
  else {
    hit = 0;
  }

  if (hit == 1) {
    shake = random(shakeMin, shakeMax);

    if (previousHit == 0 && crashSoundPath !== '') {
      crashSound.play();
    }
  }
  else {
    shake = 0;
  }

  previousHit = hit;
}

// 큰 비행기 위치에 따라 색 변경
function checkPlaneState() {
  noseY = planeY - planeNoseY;

  if (noseY > dashedLineY) {
    state = 0;
  }
  else if (noseY > solidLineY) {
    state = 1;
  }
  else {
    state = 2;
  }
}

// 큰 비행기와 착륙등
function drawMousePlane() {
  if (state == 0) {
    fill(0, 100, 255);
  }
  else if (state == 1) {
    fill(255, 255, 0);
  }
  else {
    fill(255, 0, 0);
  }

  noStroke();
  rectMode(CENTER);

  rect(planeX + shake, planeY, bodyWidth, bodyHeight);
  rect(planeX + shake, planeY - planeWingY, wingWidth, wingHeight);
  rect(planeX + shake, planeY + planeTailY, tailWidth, tailHeight);
  ellipse(planeX + shake, planeY - planeNoseY, bodyWidth, planeNoseHeight);

  // 착륙등 두 개
  if (landingLight == 1) {
    stroke(255, 255, 0);
    strokeWeight(2);

    line(
      planeX + shake - 15, planeY - 4,
      planeX + shake - 15 - lightSize / 2, planeY - 4 - lightSize
    );

    line(
      planeX + shake - 15, planeY - 4,
      planeX + shake - 15 + lightSize / 2, planeY - 4 - lightSize
    );

    line(
      planeX + shake + 15, planeY - 4,
      planeX + shake + 15 - lightSize / 2, planeY - 4 - lightSize
    );

    line(
      planeX + shake + 15, planeY - 4,
      planeX + shake + 15 + lightSize / 2, planeY - 4 - lightSize
    );

    noStroke();
    fill(255);

    ellipse(planeX + shake - 15, planeY - 4, 5, 5);
    ellipse(planeX + shake + 15, planeY - 4, 5, 5);
  }
}

// 별 5개를 먹으면 다음 스테이지
function checkStage() {
  if (step === 1 && score >= 5) {
    if (stage < 3) {
      if (stageSoundPath !== '') {
        stageSound.play();
      }

      stage++;
      resetStage();
    }
    else {
      gameResult = 1;
      step = 2;

      if (stageSoundPath !== '') {
        stageSound.play();
      }
    }
  }
}

// 스테이지 초기화
function resetStage() {
  score = 0;
  hit = 0;
  previousHit = 0;
  shake = 0;

  // 별은 노란 실선 위쪽에 생성
  for (i = 0; i < starCount; i++) {
    starVisible[i] = 1;
    starsX[i] = random(40, 560);
    starsY[i] = random(60, 300);
  }

  // 작은 비행기 수 랜덤
  planeCountRandom = random(0, 3);

  if (planeCountRandom < 1) {
    skyPlaneCount = 3;
  }
  else if (planeCountRandom < 2) {
    skyPlaneCount = 4;
  }
  else {
    skyPlaneCount = 5;
  }

  // 스테이지마다 제한시간과 비행기 수 변경
  if (stage === 1) {
    gameTime = 30;
  }
  else if (stage === 2) {
    gameTime = 25;
    skyPlaneCount++;
  }
  else {
    gameTime = 20;
    skyPlaneCount += 2;
  }

  // 스테이지별 비행기 속도
  for (i = 0; i < skyPlaneMaxCount; i++) {
    skyPlaneX[i] = -60 - i * 110;
    skyPlaneY[i] = random(skyPlaneMinY, skyPlaneMaxY);

    if (stage === 1) {
      skyPlaneSpeedX[i] = random(2.5, 4.0);
    }
    else if (stage === 2) {
      skyPlaneSpeedX[i] = random(4.5, 6.5);
    }
    else {
      skyPlaneSpeedX[i] = random(7.0, 10.0);
    }

    skyPlaneSpeedY[i] = random(0.05, 0.18);
  }

  previousTime = millis();
}

// 게임 전체 초기화
function reset() {
  stage = 1;
  gameResult = 0;
  carX = 300;
  landingLight = 0;
  lightSize = 12;

  resetStage();
}

// 종료 화면
function gameEnd() {
  drawBackground();

  fill(0);
  noStroke();
  rect(width / 2, height / 2, 555, 200);

  fill(255);
  textAlign(CENTER, CENTER);
  textSize(45);

  if (gameResult == 1) {
    text('YOU WIN!', width / 2, height / 2 - 50);
  }
  else {
    text('GAME OVER', width / 2, height / 2 - 50);
  }

  textSize(23);
  text('PRESS SPACE TO RESTART', width / 2, height / 2 + 50);

  noLoop();
}

// 마우스 클릭으로 착륙등 켜기 / 끄기
function mousePressed() {
  if (step === 1) {
    if (landingLight == 0) {
      landingLight = 1;
      lightSize = 12;
    }
    else {
      landingLight = 0;
    }
  }
}

// 스페이스바로 게임 시작 및 재시작
function keyPressed() {
  if (key === ' ') {
    if (step === 0 || step === 2) {
      reset();
      step = 1;
      loop();

      // 최초 게임 시작 시 배경음악 재생
      if (backgroundMusicPath !== '' && musicStarted == 0) {
        backgroundMusic.play();
        musicStarted = 1;
        musicPreviousTime = millis();
      }
    }
  }
}
