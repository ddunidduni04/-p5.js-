function movePlayer() {
  if (controlMode == 0) {
    planeX = constrain(
      mouseX - screenX, 25, 575
    );

    planeY = constrain(
      mouseY - screenY, 30, 570
    );

    planeAngle = 0;
    planeSpeedX = 0;
    planeSpeedY = 0;
  }
  else {
    if (pressA == 1) {
      planeAngle -= 0.05;
      rocketDirection = 0;
    }

    if (pressD == 1) {
      planeAngle += 0.05;
      rocketDirection = 1;
    }

    if (pressW == 1) {
      planeSpeedX += sin(planeAngle) * 0.45;
      planeSpeedY -= cos(planeAngle) * 0.45;
      rocketDirection = 2;
    }

    if (pressS == 1) {
      planeSpeedX -= sin(planeAngle) * 0.25;
      planeSpeedY += cos(planeAngle) * 0.25;
      rocketDirection = 3;
    }

    // W/S를 놓으면 즉시 정지
    if (pressW == 0 && pressS == 0) {
      planeSpeedX = 0;
      planeSpeedY = 0;
    }
    else {
      planeSpeedX *= friction;
      planeSpeedY *= friction;
    }

    planeX += planeSpeedX;
    planeY += planeSpeedY;

    planeX = constrain(planeX, 25, 575);
    planeY = constrain(planeY, 30, 570);
  }
}

function checkPlaneState() {
  if (planeY - 25 > 480) {
    planeState = 0;
  }
  else if (planeY - 25 > 330) {
    planeState = 1;
  }
  else {
    planeState = 2;
  }
}

function drawMousePlane() {
  push();
  translate(planeX + shake, planeY);
  rotate(planeAngle);

  noStroke();

  if (planeState == 0) {
    fill(0, 100, 255);
  }
  else if (planeState == 1) {
    fill(255, 255, 0);
  }
  else {
    fill(255, 0, 0);
  }

  if (controlMode == 0) {
    rect(0, 0, 10, 49);
    rect(0, -4, 49, 10);
    rect(0, 19, 25, 7);
    ellipse(0, -25, 10, 13);
  }
  else {
    stroke(255);
    strokeWeight(3);
    noFill();

    if (planeState == 0) {
      stroke(0, 100, 255);
    }
    else if (planeState == 1) {
      stroke(255, 255, 0);
    }
    else {
      stroke(255, 0, 0);
    }

    ellipse(0, 0, 46, 60);
    noStroke();

    image(
      rockets[rocketDirection],
      0, 0, 42, 50
    );

    stroke(255, 255, 0);
    strokeWeight(1);
    noFill();

    beginShape();
    vertex(-9, -30);
    vertex(0, -35);
    vertex(9, -30);
    endShape();
  }

  if (landingLight == 1) {
    stroke(255, 255, 0);
    strokeWeight(2);

    line(
      -15, -4,
      -15 - lightSize / 2,
      -4 - lightSize
    );

    line(
      -15, -4,
      -15 + lightSize / 2,
      -4 - lightSize
    );

    line(
      15, -4,
      15 - lightSize / 2,
      -4 - lightSize
    );

    line(
      15, -4,
      15 + lightSize / 2,
      -4 - lightSize
    );

    noStroke();
    fill(255);

    ellipse(-15, -4, 5, 5);
    ellipse(15, -4, 5, 5);
  }

  pop();
}

// 작은 비행기 관리: 클래스와 객체 배열
let skyPlanes = [];
