    lightSize = 50;
  }
}

function mouseMoved() {
  mouseActive = 1;

  if (gameStep == 0 || gameStep == 2) {
    redraw();
  }
}

function mouseDragged() {
  if (
    gameStep == 1 &&
    landingLight == 1 &&
    mouseIsPressed &&
