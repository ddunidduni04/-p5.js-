// 객체 리터럴로 이동 경로 저장
function recordPlaneTrail() {
  if (trailMode == 1) {
    if (frameCount % 3 == 0) {
      let tailVector = { x: planeX, y: planeY };
      planeTrail.push(tailVector);

      if (planeTrail.length > trailLength) {
        planeTrail.shift();
      }
    }
  }
  else {
    planeTrail = [];
  }
}

function drawPlaneTrail() {
  if (trailMode == 1) {
    noStroke();

    for (let k = 0; k < planeTrail.length; k++) {
      fill(255, 220, 0, 50 + k * 10);

      ellipse(
        planeTrail[k].x,
        planeTrail[k].y,
        3 + k / 2,
        3 + k / 2
      );
    }
  }
}

function startMusic() {
  if (soundStarted == 0) {
    bgm.play();
    soundStarted = 1;
    musicTime = millis();
  }
}

function repeatBackgroundMusic() {
  if (
    soundStarted == 1 &&
    millis() - musicTime >= musicRepeatTime
  ) {
    bgm.play();
    musicTime = millis();
  }
}

function beaconTimer() {
  hudBlink = 1 - hudBlink;
}

function timerProcess() {
  // 프레임이 지연되어도 실제 경과한 초만큼 감소
  if (gameStep == 1) {
    let elapsedSeconds = int((millis() - previousTime) / 1000);

    if (elapsedSeconds >= 1) {
      gameTime -= elapsedSeconds;
      previousTime += elapsedSeconds * 1000;
    }
  }

  if (gameStep == 1 && gameTime <= 0) {
    gameTime = 0;
    finishGame(0);
  }
}

