let skyColor = 0;

// 작은 비행기 클래스
class SkyPlane {

  constructor(x, y, speedX, speedY, noiseOffset) {
    this.x = x;
    this.y = y;
    this.speedX = speedX;
    this.speedY = speedY;
    this.noiseOffset = noiseOffset;
    this.size = 34; // 추가: 총알의 hit() 메소드에서 사용할 작은 비행기 충돌 크기
  }

  // 수정: display() 안에서 이동, 출력, 충돌 모두 처리
  display() {
    // 1. 작은 비행기 이동
    this.x += this.speedX;
    this.y += this.speedY + map(
      noise(frameCount * 0.02 + this.noiseOffset),
      0, 1, -1, 1
    );
    this.y = constrain(this.y, 65, 275);

    if (this.x > 630) {
      this.x = -30;
      this.y = random(65, 275);
    }

    // 2. 작은 비행기 출력
    rect(this.x, this.y, 24, 3);
    ellipse(this.x + 12, this.y, 5, 4);
    rect(this.x, this.y + 3, 10, 3);
    rect(this.x - 9, this.y - 3, 4, 6);

    // 3. 플레이어와 충돌 판정
    if (
      gameStep == 1 &&
      dist(this.x, this.y, planeX, planeY) < 29
    ) {
      finishGame(0);
    }
  }
}

// 스테이지별 작은 비행기 객체 생성
function resetSkyPlanes() {
  skyCount = 3 + int(random(3));

  if (stage == 2) {
    skyCount++;
  }
  else if (stage == 3) {
    skyCount += 2;
  }

  skyPlanes = [];

  for (i = 0; i < skyCount; i++) {
    let speedX = 0;

    if (stage == 1) {
      speedX = random(2.5, 4);
    }
    else if (stage == 2) {
      speedX = random(4.5, 6.5);
    }
    else {
      speedX = random(7, 10);
    }

    skyPlanes[i] = new SkyPlane(
      -60 - i * 110,
      random(65, 275),
      speedX,
      random(-0.15, 0.15),
      i * 10
    );
  }
}

// 수정: 작은 비행기 이동, 출력, 충돌 통합
function processSkyPlanes() {
  switch (1) {
    case press1:
      skyColor = 1;
      break;

    case press2:
      skyColor = 2;
      break;

    case press3:
      skyColor = 3;
      break;

    default:
      skyColor = 0;
      break;
  }

  rectMode(CENTER);

  if (skyColor == 0) {
    fill(0);
  }
  else if (skyColor == 1) {
    fill(255, 0, 0);
  }
  else if (skyColor == 2) {
    fill(0, 255, 0);
  }
  else {
    fill(0, 100, 255);
  }

  stroke(255);
  strokeWeight(1);

  // display() 메소드에서 이동, 출력, 충돌을 함께 처리
  for (i = 0; i < skyCount; i++) {
    skyPlanes[i].display();
  }

  noStroke();
}

// 추가1:  일반 적 비행기의 공통 속성과 움직임
class Enemy {
  constructor(x, y, speed) {
    // 추가: 생성할 때 전달받은 적의 초기 위치와 이동속도 저장
    this.x = x;
    this.y = y;
    this.speed = speed;
    this.angle = 0; // 추가:상하 움직임을 위한 각도
    this.size = 44; // 추가:총알과의 충돌 판정 크기
    this.life = 1; // 추가:일반 적은 총알 한 발에 제거
  }

  // 추가: 일반 적의 이동, 출력, 플레이어와 충돌 판정
  display() {
    if (this.life > 0) {
      this.angle += 0.05; // 추가:상하 이동 각도 증가
      this.y = 220 + sin(this.angle) * 42; // 추가:사인 함수를 이용해 위아래로 이동
      this.x -= this.speed; // 추가: 왼쪽으로 이동

      // 추가: 화면 왼쪽을 벗어나면 오른쪽에서 다시 등장
      if (this.x < -40) {
        this.x = 650;
