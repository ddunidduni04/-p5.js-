function keyReleased() {
  if (keyCode == 87) pressW = 0;
  if (keyCode == 65) pressA = 0;
  if (keyCode == 83) pressS = 0;
  if (keyCode == 68) pressD = 0;

  if (keyCode == 49) press1 = 0;
  if (keyCode == 50) press2 = 0;
  if (keyCode == 51) press3 = 0;

  if (keyCode == 77) pressM = 0;
  if (keyCode == 72) pressH = 0;
  if (keyCode == 75) pressK = 0; // 추가: K키를 떼면 총알 발사 중지

  // W/S를 놓으면 비행기 즉시 정지
  if (pressW == 0 && pressS == 0) {
    planeSpeedX = 0;
    planeSpeedY = 0;
  }

  skyColor = 0;
}

function keyPressed() {
  if (keyCode == 87) pressW = 1;
  if (keyCode == 65) pressA = 1;
  if (keyCode == 83) pressS = 1;
  if (keyCode == 68) pressD = 1;

  if (keyCode == 49) press1 = 1;
  if (keyCode == 50) press2 = 1;
  if (keyCode == 51) press3 = 1;
  if (gameStep == 1 && keyCode == 75) pressK = 1; // 추가: K키를 누르면 발사 상태로 변경

  if (keyCode == 70) {
    fullMode = 1;
    fullscreen(true);
    resizeCanvas(windowWidth, windowHeight);
  }

  if (keyCode == 73) {
    print(
      'Stage: ' + stage +
      ', Score: ' + score
    );

    console.log(typeof mission);
  }

  if (key == ' ') {
    if (gameStep == 0 || gameStep == 2) {
      reset();
      gameStep = 1;
      previousTime = millis();

      clearInterval(blinkId);
      blinkId = setInterval(beaconTimer, 500);

      startMusic();
      loop();
    }
  }
  else if (gameStep == 1) {

    // J키: 자동차 점프
    if (keyCode == 74 && jump == false) {
      carJumpSpeed = jumpPower;
      jump = true;
      catchSound.play();
    }

    // M키: 비행기 조작 모드 전환
    if (keyCode == 77 && pressM == 0) {
      pressM = 1;
      controlMode = (controlMode + 1) % 2;

      planeSpeedX = 0;
      planeSpeedY = 0;
      rocketDirection = 2;
    }

    // H키: 누를 때 한 번만 이동 경로 전환
    if (keyCode == 72 && pressH == 0) {
      pressH = 1;
      trailMode = (trailMode + 1) % 2;
      planeTrail = [];
    }
  }
}

function windowResized() {
  if (fullMode == 1) {
    resizeCanvas(windowWidth, windowHeight);
  }
  else {
    resizeCanvas(600, 600);
  }
}
