function drawStars() {
  for (i = 0; i < 5; i++) {
    if (starVisible[i] == 1) {
      let starSize = 5;

      starDistance = dist(
        planeX, planeY,
        starsX[i], starsY[i]
      );

      if (starDistance < 60) {
        fill(
          255 - starDistance * 255 / 60,
          255 - starDistance * 255 / 60,
          0
        );

        starSize = map(
          starDistance, 0, 60, 10, 5
        );
      }
      else {
        fill(0);
        starSize = 5;
      }

      stroke(255);
      strokeWeight(1);

      ellipse(
        starsX[i], starsY[i],
        starSize, starSize
      );

      noStroke();

      if (starDistance < 8) {
        starVisible[i] = 0;
        missionGrid[stage - 1][i] = 1;
        score++;

        catchSound.play();
      }
      else if (starDistance < 15) {
        stroke(255, 255, 0);
        strokeWeight(1);

        for (j = 0; j < 6; j++) {
          line(
            planeX, planeY,
            planeX + random(-15, 15),
            planeY + random(-15, 15)
          );
        }

        noStroke();
      }
    }
  }
}

