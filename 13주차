// 장애물 관리: 객체 리터럴 + Timer 클래스
let obstacles = [];
let obstacleSpeed = 4;
let obstacleGap = 1300;

// 장애물 생성 타이머
let obstacleTimer;
let crashX = 300;
let crashY = 300;
let burstFrames = 0;

// 추가: 장애물 생성 간격을 관리하는 클래스
class Timer {

  // 생성 간격 설정
  constructor(time) {
    this.time = time;
    this.previousTime = 0;//마지막으로 생성한 시간
  }

  // 시간 측정 시작
  start() {
    this.previousTime = millis();//ms단위
  }

  // 지정한 시간이 지났는지 확인
  check() {
    let interval = millis() - this.previousTime;

    if (interval >= this.time) {
      return true;//시간이 지나면 트루 아니면 펄
    }
    else {
      return false;
    }
  }
}

// 스테이지가 바뀌면 장애물과 타이머 초기화
function resetObstacles() {
  obstacles = [];
  burstFrames = 0;
  obstacleSpeed = 3 + stage;
  obstacleGap = 1500 - stage * 200;
  obstacleTimer = new Timer(obstacleGap);
  obstacleTimer.start();
}

function processObstacles() {

  // 추가: Timer 클래스로 장애물 생성시간 확인
  if (obstacleTimer.check()) {

    // 객체 리터럴로 장애물 생성
    let obstacle = {
      x: 630,
      y: 320,
      size: random(24, 38),
      speed: obstacleSpeed + random(0, 1.5),
      hit: 0
    };

    obstacles.push(obstacle);

    // 타이머 재시작
    obstacleTimer.start();
  }

  // 장애물 이동 및 충돌 판정
  for (let k = obstacles.length - 1; k >= 0; k--) {
    obstacles[k].x -= obstacles[k].speed;

    if (
      obstacles[k].hit == 0 &&
      dist(
        carX, 311 + carJumpY,
        obstacles[k].x, obstacles[k].y
      ) < 20 + obstacles[k].size / 2
    ) {
      obstacles[k].hit = 1;
      burstSound.play();

      crashX = carX;
      crashY = 311 + carJumpY;
      burstFrames = 15;
    }

    // 화면 밖 장애물 삭제 및 회피 횟수 증가
    if (obstacles[k].x < -obstacles[k].size) {
      if (obstacles[k].hit == 0) {
        mission.dodges++;
      }

      obstacles.splice(k, 1);
    }
    else {
      image(
        obstacleImg,
        obstacles[k].x,
        obstacles[k].y,
        obstacles[k].size,
        obstacles[k].size
      );
    }
  }

  // 충돌 폭발 효과
  if (burstFrames > 0) {
    image(
      burstImg,
      crashX, crashY,
      40, 40
    );

    burstFrames--;
  }
}

function checkCarCollision() {
  if (
    planeX + 25 > carX - 30 &&
    planeX - 25 < carX + 30 &&
    planeY + 25 > 290 + carJumpY &&
    planeY - 25 < 330 + carJumpY
  ) {
    carHit = 1;
  }
  else {
    carHit = 0;
  }

  if (carHit == 1) {
    shake = random(-5, 5);

    if (previousHit == 0) {
      burstSound.play();
    }
  }
  else {
    shake = 0;
  }

  previousHit = carHit;
}

function checkStage() {
  if (gameStep == 1 && score >= 5) {
    if (stage < 3) {
      clapSound.play();
      stage++;
      resetStage();
    }
    else {
      finishGame(1);
    }
  }
}

function resetStage() {
  score = 0;
  carHit = 0;
  previousHit = 0;
  shake = 0;

  bonusVisible = 1;
  bonusSize = 28;
  bonusNoiseX = 0;
  bonusNoiseY = 10;

  carJumpY = 0;
  carJumpSpeed = 0;
  jump = false;

  planeTrail = [];
  // 추가: 다음 스테이지에서 이전 총알이 남지 않도록 초기화
  bullets = [];
  lastShotTime = millis() - shotGap; // 추가: 스테이지 시작 직후에도 바로 발사 가능하게 설정

  for (i = 0; i < 5; i++) {
    starVisible[i] = 1;
    starsX[i] = random(40, 560);
    starsY[i] = random(100, 280);
  }

  if (stage == 1) {
    gameTime = 30;
  }
  else if (stage == 2) {
    gameTime = 25;
  }
  else {
    gameTime = 20;
  }

  stageTime = gameTime;
  resetObstacles(); // 장애물 관련 초기화는 한곳에서 처리

  resetSkyPlanes(); // 작은 비행기 초기화
  resetEnemy(); // 추가: 스테이지에 맞는 일반 적 또는 강화 적 생성

  previousTime = millis();
}

