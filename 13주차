// 추가3:총알 위치, 이동, 출력, 충돌 판정
class Bullet {
  constructor(x, y, angle) {
    // 추가: 비행기 앞쪽 30픽셀에서 총알 생성
    this.x = x + sin(angle) * 30;
    this.y = y - cos(angle) * 30;
    this.size = 5; // 추가: (총알 크기)
    this.speedX = 10 * sin(angle); // 추가: 비행기가 바라보는 방향의 X속도
    this.speedY = -10 * cos(angle); // 추가: 비행기가 바라보는 방향의 Y속도
  }

  // 추가: 총알의 위치를 매 프레임 갱신
  move() {
    this.x += this.speedX;
    this.y += this.speedY;
  }

  // 추가: 노란색 원으로 총알 출력
  display() {
    noStroke();
    fill(255, 210, 0);
    ellipse(this.x, this.y, this.size, this.size);
  }

  // 추가: 총알과 다른 객체 사이의 거리를 이용한 충돌 판정
  hit(other) {
    if (
      dist(this.x, this.y, other.x, other.y) <
      (this.size + other.size) / 2
    ) {
      return true; // 추가: 총알이 대상과 충돌한 상태
    }
    else {
      return false; // 추가: 충돌하지 않은 상태
    }
  }

  // 추가: 총알이 600x600 게임 화면을 벗어났는지 확인
  offCanvas() {
    if (this.x < 0 || this.x > 600) return true;
    if (this.y < 0 || this.y > 600) return true;
    return false;
  }
}

// 추가: K키 발사, 총알 이동과 출력, 작은 비행기와 적 비행기 명중 처리
function processBullets() {
  // 추가:게임 진행 중 K키를 누르면 일정 간격마다 총알 생성
  if (gameStep == 1 && pressK == 1) {
    if (millis() - lastShotTime >= shotGap) {
      let bullet = new Bullet(planeX, planeY, planeAngle); // 추가: 현재 비행기 위치와 각도로 Bullet 생성
      bullets.push(bullet); // 추가: 생성된 총알을 배열에 저장
      lastShotTime = millis(); // 추가: 다음 발사를 위한 시간 갱신
    }
  }

  // 추가: 배열에서 총알을 삭제할 수 있도록 마지막 인덱스부터 반복
  for (let k = bullets.length - 1; k >= 0; k--) {
    bullets[k].move(); // 추가: k번째 총알 이동
    bullets[k].display(); // 추가: k번째 총알 출력

    let bulletHit = 0; // 추가: 현재 총알이 적을 맞혔는지 저장

    // 추가: 총알과 작은 비행기들의 충돌을 확인해 한 발에 제거
    for (let j = skyPlanes.length - 1; j >= 0; j--) {
      if (bullets[k].hit(skyPlanes[j])) {
        skyPlanes.splice(j, 1); // 추가: 명중한 작은 비행기를 배열에서 삭제
        skyCount = skyPlanes.length; // 추가: 남아 있는 작은 비행기 개수 갱신
        bulletHit = 1;
        burstSound.play();
        break; // 추가: 한 발의 총알로 작은 비행기 하나만 처리
      }
    }

    // 추가: 총알과 일반 적 또는 강화 적의 충돌 확인
    if (bulletHit == 0 && enemyPlane != 0 && enemyPlane.life > 0) {
      if (bullets[k].hit(enemyPlane)) {
        enemyPlane.life--; // 추가: 명중할 때마다 적 체력 1 감소
        bulletHit = 1;

        if (enemyPlane.life == 0) {
          // 추가: 체력이 0이면 적이 사라진 위치에서 폭발 효과 발생
          enemyBurstX = enemyPlane.x;
          enemyBurstY = enemyPlane.y;
          enemyBurstFrames = 15;
          burstSound.play();
        }
        else {
          catchSound.play(); // 추가: 강화 적이 맞았지만 체력이 남아 있을 때 효과음
        }
      }
    }

    // 추가: 적을 맞혔거나 화면 밖으로 나간 총알을 배열에서 삭제
    if (bulletHit == 1 || bullets[k].offCanvas()) {
      bullets.splice(k, 1);
    }
  }
}

function moveBonus() {
  if (bonusVisible == 1) {
    bonusX = map(
      noise(bonusNoiseX), 0, 1, 80, 520
    );

    bonusY = map(
      noise(bonusNoiseY), 0, 1, 95, 285
    );

    bonusNoiseX += 0.009;
    bonusNoiseY += 0.009;

    // 비행기가 보너스에 닿으면 2초 획득
    if (
      dist(
        planeX, planeY,
        bonusX, bonusY
      ) < bonusSize / 2
    ) {
      gameTime += 2;
      gameTime = constrain(gameTime, 0, stageTime);
      bonusVisible = 0;
      catchSound.play();
    }
  }
}

