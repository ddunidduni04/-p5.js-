      image(enemyImg, this.x, this.y, 44, 35); // 추가: 적 비행기 이미지 출력

      // 추가: 플레이어와 적 비행기가 가까워지면 게임 종료
      if (
        gameStep == 1 &&
        dist(planeX, planeY, this.x, this.y) < 32
      ) {
        finishGame(0);
      }
    }
  }
}

