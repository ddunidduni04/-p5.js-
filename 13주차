function finishGame(result) {
  if (gameStep == 1) {
    gameResult = result;
    gameStep = 2;

    clearInterval(blinkId);

    if (result == 1) {
      clapSound.play();
    }
    else {
      burstSound.play();
    }
  }
}

function gameEnd() {
  gameBackground.display();

  push();
  translate(screenX, screenY);

  fill(0);
  noStroke();
  rect(300, 300, 555, 230);

  fill(255);
  textAlign(CENTER, CENTER);
